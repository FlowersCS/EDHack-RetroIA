# Configuración de variables de entorno para desarrollo local
# IMPORTANTE: En producción, estas variables deben configurarse de forma segura

# API Key de Gemini (obtener de https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyBsPbuRIzdduLgzlIbm9fojmoMzOxqXk48

# Configuración de Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Configuración de archivos
UPLOAD_FOLDER=../uploads
MAX_FILE_SIZE=16777216  # 16MB en bytes

# Configuración de Google APIs
# Los archivos credentials.json y token.json deben estar en la carpeta config/
GOOGLE_CREDENTIALS_PATH=../config/credentials.json
GOOGLE_TOKEN_PATH=../config/token.json

# Configuración del servidor
HOST=127.0.0.1
PORT=5000